{
    "name": "mbuzz/mbuzz-wp",
    "description": "Mbuzz multi-touch attribution for WordPress — server-side conversion tracking for Woo, EDD, and the major form plugins.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "woocommerce", "attribution", "analytics", "marketing", "mbuzz"],
    "homepage": "https://mbuzz.co",
    "authors": [
        {
            "name": "Mbuzz",
            "email": "support@mbuzz.co"
        }
    ],
    "require": {
        "php": ">=8.1",
        "mbuzz/mbuzz-php": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Mbuzz\\WP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mbuzz\\WP\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit"
    }
}
